# The project's real (public) values are already in ".env", which is shared.
# Only if you want your OWN Supabase project: copy this file to ".env.local"
# and fill in the two values from
# Supabase → Project Settings → API Keys (see CLAUDE.md / the setup guide).
#
# Both are PUBLIC values (safe in the browser): the database's Row Level
# Security rules decide what each signed-in teacher may see.
# NEVER put the "secret" / "service_role" key in this app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
