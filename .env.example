# The project's real (public) values are already in ".env", which is shared.
# Only if you want your OWN Supabase project: copy this file to ".env.local"
# and fill in the two values from
# Supabase → Project Settings → API Keys (see CLAUDE.md / the setup guide).
#
# Both are PUBLIC values (safe in the browser): the database's Row Level
# Security rules decide what each signed-in teacher may see.
# NEVER put the "secret" / "service_role" key in this app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# =====================================================================
# SERVER-ONLY SETTINGS (secrets). They go in ".env.local" on your computer
# and in your hosting's "environment variables" — NEVER in ".env" (which is
# uploaded to GitHub) and never with a NEXT_PUBLIC_ name.
# Leave them empty here. docs/GO_LIVE.md says where each value comes from.
# =====================================================================

# The site's own public address, e.g. https://mathtest.ge (no slash at the end).
# Payment providers send their messages to it. Empty = the address of each request.
SITE_URL=

# --- Payments (stage 2) ---
# Which provider: "flitt", "bog" or "mock" (the pretend bank; works only in
# `npm run dev` and the sandbox). Empty: mock in development, OFF on a real site.
PAYMENT_PROVIDER=
# A long random text (24+ characters). Our server passes it to the database
# functions that change a plan; the same text is set once in the database with
#   select public.set_server_secret('billing', '…');
BILLING_SERVER_SECRET=
# Protects /api/cron/billing: the scheduler sends "Authorization: Bearer <this>".
CRON_SECRET=

# Flitt (pay.flitt.com → merchant portal). Test merchant: 1549901 with key "test".
FLITT_MERCHANT_ID=
FLITT_SECRET_KEY=

# Bank of Georgia (businessmanager.bog.ge → Payments API).
BOG_CLIENT_ID=
BOG_CLIENT_SECRET=
# The bank's PUBLIC key for checking callbacks, from api.bog.ge/docs → Payments → Callback.
# One line; write line breaks as \n.
BOG_CALLBACK_PUBLIC_KEY=
# "1" while the BoG credentials are test ones (shows the TEST MODE banner).
BOG_TEST_MODE=

# Optional: the key that signs the pretend bank's messages (a built-in one is used when empty).
MOCK_PAYMENTS_SECRET=

# --- Emails ---
# Resend (resend.com) API key and the sender, e.g. "MathTest <hello@mathtest.ge>".
# Both empty = no email is sent; in development emails are printed in the terminal.
RESEND_API_KEY=
EMAIL_FROM=

# --- Local testing only ---
# "1" = use the pretend in-memory database for billing (npm run dev:sandbox sets both).
# NEVER set these on a real site.
MATHTEST_SANDBOX=
NEXT_PUBLIC_MATHTEST_SANDBOX=

# --- AI question generator (stage 3) ---
# Anthropic API key (console.anthropic.com → API keys). Empty = "mock mode":
# ready-made sample questions, nothing is sent to Anthropic and nothing costs money.
ANTHROPIC_API_KEY=

# --- Voice of the "how to use it" videos (only for `npm run tutorials`, never used by the site) ---
# Microsoft Azure Speech: the key and region of your Speech resource (see docs/TUTORIAL_VIDEOS.md).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
