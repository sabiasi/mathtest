# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …but the example (placeholders only, no real keys) is shared
!.env.example
# …and .env, which holds only the PUBLIC Supabase address and publishable key
!.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tour video: rendered output and captured frames (re-made by video/README.md)
/output
/video/node_modules
/video/public/capture
/video/out

# tutorial videos: spoken sentences made by Azure (made again from the scripts when needed)
/tutorials/.voice-cache/
/tutorials/.venv/
